# UniMate API configuration. Copy to api/.env and fill in. Never commit api/.env.

# --- Snowflake (live mode needs ACCOUNT, USER, PASSWORD and WAREHOUSE) ---
# Account identifier, e.g. orgname-accountname (no .snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Programmatic access token (takes precedence over password when set).
SNOWFLAKE_TOKEN=
SNOWFLAKE_WAREHOUSE=
# Database and schema created by snowflake/*.sql
SNOWFLAKE_DATABASE=PIP
SNOWFLAKE_SCHEMA=APP
# Optional role; leave empty to use the user's default role
SNOWFLAKE_ROLE=

# --- Mode ---
# true runs the whole demo with zero Snowflake config (in-memory store + TypeScript ranker, source "fallback").
# false uses Snowflake when configured; if the Snowflake vars above are missing the API still falls back to mock mode.
MOCK_MODE=false

# --- Server ---
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info
# LOG_LEVEL=debug shows every Snowflake SQL statement

# --- Scenario clock ---
# HH:MM freezes the plan clock at that time today (13:13 reproduces "47 min free until CHEM 110 Lab, 2:00 PM").
# real uses the real local time. Unset: 13:13 in mock mode, real time in live mode.
# DEMO_NOW=13:13

# IANA time zone for plans and the Snowflake session TIMEZONE. Defaults to this machine's zone.
# PIP_TIMEZONE=America/Los_Angeles

# Optional ElevenLabs voice playback; device speech remains the fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
