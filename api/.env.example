# UniMate API configuration. Copy to api/.env and fill in. Never commit api/.env.

# --- Snowflake (live mode needs ACCOUNT, USER, PASSWORD and WAREHOUSE) ---
# Account identifier, e.g. orgname-accountname (no .snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Programmatic access token (takes precedence over password when set).
SNOWFLAKE_TOKEN=
SNOWFLAKE_WAREHOUSE=
# Database and schema created by snowflake/*.sql
SNOWFLAKE_DATABASE=PIP
SNOWFLAKE_SCHEMA=APP
# Optional role; leave empty to use the user's default role
SNOWFLAKE_ROLE=

# --- Claude extraction fallback (optional) ---
# When set, transcript extraction tries Claude before the heuristic parser (mock mode and the in-memory fallback), and
# after a failed EXTRACT_FROM_TRANSCRIPT in live mode. Any error, timeout or invalid output uses the heuristic
# parser on the submitted input. A successful empty extraction stays empty.
ANTHROPIC_API_KEY=
# Fast model for low-latency extraction
# PIP_CLAUDE_MODEL=claude-haiku-4-5
# One request, no retries; then the heuristic parser answers
# PIP_CLAUDE_TIMEOUT_MS=8000

# --- Mode ---
# true uses in-memory storage + TypeScript ranking, source "fallback". Only student_id=demo gets seeded tasks.
# false uses Snowflake when configured; if the Snowflake vars above are missing the API still falls back to mock mode.
MOCK_MODE=false

# --- Server ---
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info
# LOG_LEVEL=debug shows every Snowflake SQL statement

# --- Scenario clock ---
# HH:MM freezes the plan clock at that time today (13:13 reproduces "47 min free until CHEM 110 Lab, 2:00 PM").
# real (or unset) uses real local time in both modes. Use 13:13 only for the explicit demo.
DEMO_NOW=real

# IANA time zone for plans and the Snowflake session TIMEZONE. Defaults to this machine's zone.
# PIP_TIMEZONE=America/Los_Angeles

# Optional ElevenLabs voice playback; device speech remains the fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.4
ELEVENLABS_SPEED=1.03

# false restores optional AI wording for plain captures. Specific questions retain it.
FAST_CAPTURE_PLAN=true
